---
import '../styles/global.css';
import CodeEditor from '../components/CodeEditor';
import Sticker from '../components/Sticker.astro';

const title = 'toitoi.dev';
const description = 'toitoi — interactive landing with a tiny code playground.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fafafa" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Fira+Code:wght@400;500&family=IBM+Plex+Mono:wght@400;500&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <video
      class="bg-video is-active"
      src="/video/school_10s.webm"
      autoplay
      muted
      playsinline
      preload="auto"
      aria-hidden="true"></video>
    <video class="bg-video" src="/video/hotel_10s.webm" muted playsinline preload="auto" aria-hidden="true"></video>
    <video class="bg-video" src="/video/bk_10s.webm" muted playsinline preload="auto" aria-hidden="true"></video>
    <Sticker />
    <script>
      // school -> hotel -> bk -> school ... One <video> per clip, each keeps its own src (never reloaded).
      // When one ends, the next (already rewound and buffered) starts, and the finished one rewinds.
      const clips = Array.from(document.querySelectorAll<HTMLVideoElement>('.bg-video'));
      let current = 0;

      const advance = () => {
        const prev = clips[current];
        current = (current + 1) % clips.length;
        const next = clips[current];
        const show = () => {
          next.play().catch((err) => console.warn('bg video play failed', next.src, err));
          next.classList.add('is-active');
          prev.classList.remove('is-active');
          prev.currentTime = 0;
        };
        if (next.readyState >= 3) show();
        else next.addEventListener('canplay', show, { once: true });
      };

      clips.forEach((v) => {
        v.addEventListener('ended', () => v === clips[current] && advance());
        v.addEventListener('error', () => console.warn('bg video error', v.src, v.error));
      });
    </script>
    <main>
      <section id="playground" class="playground">
        <!-- <div class="playground-frame">
          <CodeEditor client:visible />
        </div> -->
      </section>
    </main>
  </body>
</html>
