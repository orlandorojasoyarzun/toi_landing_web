---
import '../styles/global.css';
import CodeEditor from '../components/CodeEditor';
import Sticker from '../components/Sticker.astro';

const title = 'toitoi.dev';
const description = 'toitoi.dev landing web page.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#1a0a09" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Fira+Code:wght@400;500&family=IBM+Plex+Mono:wght@400;500&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <video class="bg-video is-active" data-clip="school" autoplay muted playsinline preload="auto" aria-hidden="true"></video>
    <video class="bg-video" data-clip="hotel" muted playsinline preload="none" aria-hidden="true"></video>
    <video class="bg-video" data-clip="bk" muted playsinline preload="none" aria-hidden="true"></video>
    <Sticker />
    <script>
      // school -> hotel -> bk -> school ... One <video> per clip, each keeps its own src (never reloaded).
      // Phones get the light 480p files; only the playing clip loads at first, the next one is
      // fetched once the current one is a few seconds in, so they never compete for bandwidth.
      const clips = Array.from(document.querySelectorAll<HTMLVideoElement>('.bg-video'));
      const suffix = window.matchMedia('(max-width: 720px)').matches ? '-m' : '';
      let current = 0;

      clips.forEach((v) => {
        v.src = `/video/${v.dataset.clip}${suffix}.mp4`;
      });
      clips[0].play().catch(() => {});

      const warm = (v: HTMLVideoElement) => {
        if (v.dataset.warm) return;
        v.dataset.warm = '1';
        v.preload = 'auto';
        v.load();
      };

      const advance = () => {
        const prev = clips[current];
        current = (current + 1) % clips.length;
        const next = clips[current];
        const show = () => {
          next.play().catch((err) => console.warn('bg video play failed', next.src, err));
          next.classList.add('is-active');
          prev.classList.remove('is-active');
          prev.currentTime = 0;
        };
        warm(next);
        if (next.readyState >= 3) show();
        else next.addEventListener('canplay', show, { once: true });
      };

      clips.forEach((v, i) => {
        v.addEventListener('ended', () => v === clips[current] && advance());
        v.addEventListener('timeupdate', () => {
          if (v === clips[current] && v.currentTime > 3) warm(clips[(i + 1) % clips.length]);
        });
        v.addEventListener('error', () => console.warn('bg video error', v.src, v.error));
      });
    </script>
    <main>
      <section id="playground" class="playground">
        <!-- <div class="playground-frame">
          <CodeEditor client:visible />
        </div> -->
      </section>
    </main>
  </body>
</html>
