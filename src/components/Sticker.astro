---
// White sticker over the video: title + menu whose rows slide up under the title when opened,
// plus the social links sticker pinned bottom-right.
// Content is placeholder text — edit the arrays below.
const rows = [
  {
    num: '01',
    label: 'Who am I',
    body: [
      'Full-stack PHP developer who builds web appliactions from the database to the browser.',
      'I also like to make games in Godot and 3D in Blender on the side.',
    ],
  },
  {
    num: '02',
    label: 'Projects',
    body: [
      "I'm currently building Laravel web apps for all sort of purposes.",
      "Also, I'm a big fan of text editors and TUI tooling.",
      "For no reason: ", 
      "· I'm building my own JS Playgroud: OxiJS",
      "· An AI companion OS X native called: toi_companion",
      "· & nerdy stuff for the terminal",
      "· Most recent, I'm building the game of my dreams",
    ],
  },
  {
    num: '03',
    label: 'Contact',
    body: [
      'Barcelona based. Find my socials bottom right corner.',
      'orlandorojasoyarzun@gmail.com',
      'Do not hesitate to contact me over any inquiry.',
      'Or to collab together 🟇.', 
    ],
  },
];
---

<aside class="sticker" aria-label="menú">
  <h1 class="sticker-title">toitoi.dev</h1>

  <ul class="sticker-rows">
    {
      rows.map((r, i) => (
        <li class="sticker-item">
          <button
            type="button"
            class="sticker-row"
            aria-expanded="false"
            aria-controls={`panel-${i}`}
          >
            <span class="row-label">{r.label}</span>
            <span class="row-num">{r.num}</span>
          </button>
          <div class="row-panel" id={`panel-${i}`}>
            <div class="row-body">
              <div class="row-body-inner">
                {r.body.map((line) => (
                  <p>{line}</p>
                ))}
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</aside>

